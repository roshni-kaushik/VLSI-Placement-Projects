3C011234    // LUI  $1, 0x1234
34215678    // ORI  $1, $1, 0x5678

2002000A    // ADDI $2, $0, 10
20030014    // ADDI $3, $0, 20

00432020    // ADD  $4, $2, $3
00622822    // SUB  $5, $3, $2
00433024    // AND  $6, $2, $3
00433025    // OR   $6, $2, $3
00433826    // XOR  $7, $2, $3
00434027    // NOR  $8, $2, $3
0043482A    // SLT  $9, $2, $3

00025080    // SLL  $10, $2, 2
00025842    // SRL  $11, $2, 1
00036043    // SRA  $12, $3, 1

AC040000    // SW   $4, 0($0)
8C0B0000    // LW   $11, 0($0)

11640001    // BEQ  $11, $4, +1 (skip next instruction if equal)

200C1111    // ADDI $12, $0, 0x1111 (should be skipped)

FFFFFFFF    // HALT