    %vpi_call 2 112 "$display", "UART Simulation Completed" {0 0 0};
    %vpi_call 2 113 "$display", "--------------------------------" {0 0 0};
    %vpi_call 2 115 "$finish" {0 0 0};
    %end;
    .thread T_4;
